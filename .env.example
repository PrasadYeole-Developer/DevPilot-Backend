# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- GitHub (read-only personal access token; no write/repo-admin scopes needed) ---
# Optional for public repos. Required for private repos. Raises the rate limit
# from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Optional ingestion limits (sensible defaults apply if left unset)
GITHUB_REQUEST_TIMEOUT_SECONDS=10
GITHUB_MAX_FILE_SIZE_BYTES=500000
GITHUB_MAX_FILES=500
GITHUB_MAX_CONCURRENT_REQUESTS=10

# --- Google GenAI ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_CHAT_MODEL=gemini-3.8-flash
GOOGLE_TEMPERATURE=0.2

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=devpilot-code
# Serverless index location, used only the first time the index is created.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Chunking (optional; sensible defaults apply if left unset) ---
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# --- Agent (optional; caps the agent's tool-calling loop) ---
AGENT_RECURSION_LIMIT=15

# --- Bug investigation (optional; caps the investigation workflow) ---
INVESTIGATION_MAX_ROUNDS=3
INVESTIGATION_RECURSION_LIMIT=60
